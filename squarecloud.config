{
  "name": "bernas-agent",
  "description": "Bot de Economia Autônoma entre IAs - IA + Blockchain + WhatsApp",
  "type": "worker",
  "start": "python scripts/start_bot.py",
  "version": "3.11",
  "env": {
    "DEBUG": "false",
    "LOG_LEVEL": "INFO",
    "HTTP_PORT": "8080",
    "ECONOMY_PORT": "4020"
  },
  "resources": {
    "memory": 512,
    "cpu": 0.5
  },
  "autoRestart": true,
  "restartDelay": 10,
  "healthCheck": {
    "path": "/api/v1/health",
    "interval": 30,
    "timeout": 5
  }
}