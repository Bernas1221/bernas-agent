# BERNAS-AGENT - Configuração de Ambiente
# Baseado na arquitetura Moltbook Crypto Bot
# Copie este arquivo para .env e preencha os valores

# ============================================
# CHAVES DE API DE IA
# ============================================

# Gemini API (Google)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenClaude API
OPENCLAUDE_API_KEY=your_openclaude_api_key_here

# Kiro API
KIRO_API_KEY=your_kiro_api_key_here

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NVIDIA API
NVIDIA_API_KEY=your_nvidia_api_key_here

# ============================================
# BLOCKCHAIN - SOLANA
# ============================================

# Chave privada da carteira Solana (Base58)
SOLANA_PRIVATE_KEY=your_solana_private_key_base58_here

# Endpoint RPC da Solana (opcional)
SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# ============================================
# WHATSAPP - CAMADAS DE FALLBACK
# ============================================

# Camada 1: CallMeBot (gratuito, com limites)
CALLMEBOT_API_KEY=your_callmebot_api_key_here

# Camada 2: Selenium (automação local)
SELENIUM_ENABLED=false
# SELENIUM_CHROME_DRIVER_PATH=/path/to/chromedriver

# Camada 3: Twilio (pago, mais confiável)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886  # Número Twilio Sandbox

# Camada 4: Evolution API (self-hosted)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE=default

# ============================================
# CONFIGURAÇÕES DO BOT
# ============================================

# Contatos para alertas (separados por vírgula)
ALERT_CONTACTS=+5511999999999,+5511888888888

# Porta HTTP para API do bot
HTTP_PORT=8080

# Porta para servidor de economia (HTTP 402)
ECONOMY_PORT=4020

# Modo de depuração
DEBUG=false

# ============================================
# ECONOMIA - MARKETPLACE
# ============================================

# Saldo inicial das carteiras (em USDC)
INITIAL_BALANCE_USDC=100

# Taxa de serviço do marketplace (percentual)
MARKETPLACE_FEE_PERCENT=2.5

# ============================================
# LOGGING
# ============================================

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Diretório de logs
LOG_DIR=logs

# ============================================
# SEGURANÇA
# ============================================

# Token para API admin (opcional)
ADMIN_API_TOKEN=your_admin_token_here

# IPs permitidos para admin (separados por vírgula)
ALLOWED_ADMIN_IPS=127.0.0.1,192.168.1.0/24

# ============================================
# AGENDAMENTO (CRONJOBS)
# ============================================

# Intervalo de relatório diário (horas)
DAILY_REPORT_HOUR=8

# Intervalo de limpeza de logs (dias)
LOG_RETENTION_DAYS=7

# ============================================
# DISCORD BOT
# ============================================

# Token do Bot Discord (obrigatório para Discord)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Prefixo de comandos do Discord
DISCORD_COMMAND_PREFIX=!

# ID do servidor Discord (opcional)
DISCORD_GUILD_ID=your_guild_id_here

# IDs dos canais permitidos (separados por vírgula)
DISCORD_ALLOWED_CHANNELS=general,commands,bot-commands

# ============================================
# MOLTBOOK DASHBOARD
# ============================================

# Intervalo de atualização do dashboard (segundos)
MOLTBOOK_UPDATE_INTERVAL=30

# Histórico de métricas (horas)
MOLTBOOK_HISTORY_HOURS=24

# ============================================
# GERADORES DE RECEITA
# ============================================

# Intervalo de geração automática (segundos)
REVENUE_GENERATION_INTERVAL=60

# Número máximo de transações por ciclo
MAX_TRANSACTIONS_PER_CYCLE=5

# Receita mínima por transação (USDC)
MIN_REVENUE_PER_TRANSACTION=0.01

# Receita máxima por transação (USDC)
MAX_REVENUE_PER_TRANSACTION=0.30

# ============================================
# SIMULAÇÃO (para desenvolvimento)
# ============================================

# Modo de simulação (true para desenvolvimento)
SIMULATION_MODE=true

# Taxa de sucesso da simulação (percentual)
SIMULATION_SUCCESS_RATE=95

# Latência simulada (milissegundos)
SIMULATION_LATENCY_MS=100

# ============================================
# RENDER.COM DEPLOYMENT
# ============================================

# Porta para Render.com (não alterar)
PORT=8080

# Workers para Gunicorn (se usado)
WEB_CONCURRENCY=1

# Timeout para requests (segundos)
REQUEST_TIMEOUT=120

# ============================================
# 9ROUTER CONFIGURATION
# ============================================

# API Key do 9ROUTER (se usando)
NINEROUTER_API_KEY=your_9router_api_key_here

# URL do 9ROUTER (padrão localhost)
NINEROUTER_API_URL=http://localhost:20128

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. NUNCA compartilhe chaves privadas
# 2. Use variáveis de ambiente em produção
# 3. Backup regular das carteiras
# 4. Monitore custos de API
# 5. Configure alertas para erros críticos
# 6. Para Discord: https://discord.com/developers/applications
# 7. Para Render.com: Adicione variáveis no dashboard
# 8. Teste localmente antes de deploy
# 9. Monitore logs regularmente
# 10. Configure webhooks para alertas